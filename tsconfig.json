{
    "compilerOptions": {
        "module": "Node16",
        "moduleResolution": "Node16",
        "target": "ES2020",
        "lib": ["ES2020"],
        "sourceMap": true,
        "rootDir": ".",
        "strict": true,
        "allowUnreachableCode": false,
        "allowUnusedLabels": false,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "noEmitOnError": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitAny": true,
        "noImplicitOverride": true,
        "noImplicitReturns": true,
        "noUnusedLocals": true,
        "resolveJsonModule": true,
        "strictPropertyInitialization": true,
        "skipLibCheck": true
    },
    "include": [
        "src/**/*.ts",
        ".vscode-test.ts",
        "eslint.config.ts",
        "mochaReporter.ts",
        "webpack.config.ts",
        "scripts/**/*.ts",
        "webviews/pq-test-result-view/eslint.config.ts",
        "webviews/pq-test-result-view/config/**/*.ts",
        "webviews/pq-test-result-view/scripts/**/*.ts"
    ],
    "exclude": ["node_modules", ".vscode-test", "dist", "out", "webviewDist", "test-resources", "unit-tests"]
}
