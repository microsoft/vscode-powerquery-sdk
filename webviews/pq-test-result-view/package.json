{
    "name": "pq-test-result-view",
    "private": true,
    "description": "The web view for pqtest results",
    "scripts": {
        "clean": "rimraf ../../webviewDist/pq-test-result-view",
        "start": "ts-node --project ../../tsconfig.configs.json scripts/start.ts",
        "build": "npm run clean && ts-node --project ../../tsconfig.configs.json ../../node_modules/webpack-cli/bin/cli.js --config config/webpack.prod.ts",
        "lint": "eslint src --config eslint.config.ts",
        "audit": "npm audit"
    },
    "engines": {
        "node": "^22.13.0 || >=24"
    },
    "dependencies": {
        "@babel/runtime": "^7.27.6",
        "@fluentui/react": "^8.115.7",
        "classnames": "^2.5.1",
        "react": "17.0.2",
        "react-dom": "17.0.2"
    },
    "devDependencies": {
        "@babel/core": "^7.24.0",
        "@babel/eslint-parser": "^7.25.1",
        "@babel/plugin-transform-class-properties": "^7.25.4",
        "@babel/plugin-transform-runtime": "^7.24.0",
        "@babel/preset-env": "^7.24.0",
        "@babel/preset-react": "^7.23.3",
        "@babel/preset-typescript": "^7.23.3",
        "@types/react": "^17.0.76",
        "@types/react-dom": "^17.0.25",
        "@types/vscode-webview": "^1.57.5",
        "babel-loader": "^8.4.1",
        "clean-webpack-plugin": "^4.0.0",
        "copy-webpack-plugin": "^14.0.0",
        "css-loader": "^7.1.2",
        "dotenv": "^17.0.1",
        "dotenv-expand": "^12.0.2",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^6.0.0-rc.1",
        "file-loader": "^6.2.0",
        "fork-ts-checker-webpack-plugin": "^9.1.0",
        "html-webpack-plugin": "^5.6.3",
        "style-loader": "^4.0.0",
        "webpack-merge": "^6.0.1"
    }
