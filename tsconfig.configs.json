{
    "compilerOptions": {
        "module": "Node16",
        "moduleResolution": "Node16",
        "target": "ES2020",
        "esModuleInterop": true,
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "types": ["node", "mocha"]
    },
    "include": [
        ".vscode-test.ts",
        "eslint.config.ts",
        "mochaReporter.ts",
        "webpack.config.ts",
        "scripts/copyTestFixtures.ts",
        "webviews/pq-test-result-view/eslint.config.ts",
        "webviews/pq-test-result-view/config/**/*.ts",
        "webviews/pq-test-result-view/scripts/**/*.ts"
    ]
}
