{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "module": "Node16",
        "moduleResolution": "Node16",
        "noEmit": true,
        "types": ["node", "mocha"]
    },
    "include": [
        ".vscode-test.ts",
        "eslint.config.ts",
